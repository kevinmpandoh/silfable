# =========================================================
# Mirae Web Environment Variables
# =========================================================

# Solana RPC Endpoint
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------
# Token Gate Configuration (for Desktop Downloads)
# ---------------------------------------------------------
# Set the SPL Token Mint address required to unlock downloads.
# Default: Mirae token (A4axW4db7Tdu7Yu3NyxqZ7ZDWVxUNBC8VXyzYE2upump)
NEXT_PUBLIC_TOKEN_GATE_MINT=A4axW4db7Tdu7Yu3NyxqZ7ZDWVxUNBC8VXyzYE2upump

# Minimum token amount required to unlock downloads
NEXT_PUBLIC_TOKEN_GATE_REQUIRED_BALANCE=100000

# Token symbol for display
NEXT_PUBLIC_TOKEN_GATE_SYMBOL=$MIRAE

# ---------------------------------------------------------
# Quick Testing Examples:
# To test with USDC on Solana:
# NEXT_PUBLIC_TOKEN_GATE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# NEXT_PUBLIC_TOKEN_GATE_REQUIRED_BALANCE=1
# NEXT_PUBLIC_TOKEN_GATE_SYMBOL=USDC
#
# To test with Wrapped SOL:
# NEXT_PUBLIC_TOKEN_GATE_MINT=So11111111111111111111111111111111111111112
# NEXT_PUBLIC_TOKEN_GATE_REQUIRED_BALANCE=0.01
# NEXT_PUBLIC_TOKEN_GATE_SYMBOL=wSOL
# ---------------------------------------------------------
