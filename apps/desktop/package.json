{
  "name": "@silfable/desktop",
  "version": "0.1.0",
  "description": "Local-first AI trading runtime with enforceable limits",
  "private": true,
  "homepage": "https://github.com/kevinmpandoh/silfable",
  "author": {
    "name": "Silfable",
    "email": "kevinmpandoh@users.noreply.github.com"
  },
  "desktopName": "Silfable",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test src/main/**/*.test.ts",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --arm64",
    "dist:linux:x64": "npm run build && electron-builder --linux AppImage deb --x64"
  },
  "dependencies": {
    "@silfable/contracts": "0.1.0",
    "@silfable/core": "0.1.0",
    "@solana-program/system": "^0.13.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "bip39": "^3.1.0",
    "micro-key-producer": "^0.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "7.3.6"
  }
}
