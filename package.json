{
  "name": "silfable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @silfable/web",
    "build:web": "npm run build --workspace @silfable/web",
    "lint:web": "npm run lint --workspace @silfable/web",
    "dev:desktop": "npm run dev --workspace @silfable/desktop",
    "build:desktop": "npm run build --workspace @silfable/desktop",
    "setup:electron": "npm exec --workspace @silfable/desktop -- install-electron",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
